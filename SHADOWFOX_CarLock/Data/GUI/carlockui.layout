WindowWidgetClass CarLockFrame {
 clipchildren 0
 position 0 0
 size 400 600
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 style Default
 {
  PanelWidgetClass CarLockPanel {
   ignorepointer 1
   color 0.1 0.1 0.1 0.95
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_black_2
   {
    ButtonWidgetClass BttnCancel {
     color 0.8 0.3 0 1
     position 10 10
     size 30 30
     halign right_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "X"
     font "gui/fonts/metron"
    }
    TextWidgetClass Title {
     ignorepointer 1
     position 0 40
     size 1 40
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "VEHICLE SECURITY"
     font "gui/fonts/metron-bold22"
     "text color" 0.8 0.3 0 1
     "text halign" center
     "text valign" center
    }
    TextWidgetClass TextOutPut {
     ignorepointer 1
     position 0 90
     size 0.9 30
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text ""
     font "gui/fonts/metron22"
     "text color" 1 1 1 1
     "text halign" center
     "text valign" center
    }
    EditBoxWidgetClass PasswordInput {
     color 0.2 0.2 0.2 1
     position 0 130
     size 300 60
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style DefaultBorder
     text ""
     font "gui/fonts/metron-bold48"
     "text color" 0.8 0.3 0 1
     "text halign" center
     "text valign" center
    }
    PanelWidgetClass NumpadPanel {
     ignorepointer 1
     position 0 210
     size 320 280
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      ButtonWidgetClass BttnNum1 { color 0.15 0.15 0.15 1; position 0 0; size 100 60; style Editor; text "1"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum2 { color 0.15 0.15 0.15 1; position 110 0; size 100 60; style Editor; text "2"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum3 { color 0.15 0.15 0.15 1; position 220 0; size 100 60; style Editor; text "3"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum4 { color 0.15 0.15 0.15 1; position 0 70; size 100 60; style Editor; text "4"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum5 { color 0.15 0.15 0.15 1; position 110 70; size 100 60; style Editor; text "5"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum6 { color 0.15 0.15 0.15 1; position 220 70; size 100 60; style Editor; text "6"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum7 { color 0.15 0.15 0.15 1; position 0 140; size 100 60; style Editor; text "7"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum8 { color 0.15 0.15 0.15 1; position 110 140; size 100 60; style Editor; text "8"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum9 { color 0.15 0.15 0.15 1; position 220 140; size 100 60; style Editor; text "9"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnClear { color 0.3 0.1 0.1 1; position 0 210; size 100 60; style Editor; text "CLR"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnNum0 { color 0.15 0.15 0.15 1; position 110 210; size 100 60; style Editor; text "0"; font "gui/fonts/metron-bold22"; }
      ButtonWidgetClass BttnDelete { color 0.1 0.1 0.3 1; position 220 210; size 100 60; style Editor; text "DEL"; font "gui/fonts/metron-bold22"; }
     }
    }
    ButtonWidgetClass BttnOK {
     color 0.8 0.3 0 1
     position 0 20
     size 320 50
     halign center_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "CONFIRM"
     font "gui/fonts/metron-bold22"
    }
   }
  }
 }
}
